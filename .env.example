# Copy this file to .env.local and fill in ONE of the two options.
# Never commit .env.local: it holds secrets.

# ── Option A (recommended): CRM Inbound Webhook ───────────────────────────────
# In the CRM: Automation → Workflows → Create workflow → Trigger "Inbound Webhook".
# Copy the webhook URL it shows and paste it here.
CRM_WEBHOOK_URL=

# ── Option B: CRM API (private integration) ──────────────────────────────────
# Settings → Private Integrations → create one with scopes: contacts.write, opportunities.write.
# Location ID: Settings → Business Profile (or the ID in your sub-account URL).
CRM_API_TOKEN=
CRM_LOCATION_ID=
# Optional: also create an opportunity in your sales pipeline at the "New lead" stage.
CRM_PIPELINE_ID=
CRM_STAGE_ID=
